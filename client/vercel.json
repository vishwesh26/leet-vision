{
    "headers": [
        {
            "source": "/ads.txt",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "text/plain; charset=utf-8"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/docs/:path*",
            "destination": "https://leet-vision-docs.vercel.app/docs/:path*"
        },
        {
            "source": "/docs",
            "destination": "https://leet-vision-docs.vercel.app/docs"
        },
        {
            "source": "/((?!api).*)",
            "destination": "/index.html"
        }
    ]
}
