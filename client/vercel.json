{
    "rewrites": [
        {
            "source": "/docs/:path*",
            "destination": "https://leet-vision-docs.vercel.app/docs/:path*"
        },
        {
            "source": "/docs",
            "destination": "https://leet-vision-docs.vercel.app/docs"
        },
        {
            "source": "/((?!api).*)",
            "destination": "/index.html"
        }
    ]
}