{
    "manifest_version": 3,
    "name": "LeetVision - Universal Problem Intelligence",
    "version": "1.0.0",
    "description": "Get instant DSA insights and related problems across LeetCode, HackerRank, GFG, and CodeChef.",
    "permissions": [
        "activeTab",
        "storage"
    ],
    "host_permissions": [
        "https://leetcode.com/*",
        "https://www.hackerrank.com/*",
        "https://www.geeksforgeeks.org/*",
        "https://www.codechef.com/*",
        "https://leet-vision.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://leetcode.com/problems/*",
                "https://www.hackerrank.com/challenges/*",
                "https://www.geeksforgeeks.org/problems/*",
                "https://www.codechef.com/problems/*"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "overlay.css"
            ]
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icon.png"
    },
    "icons": {
        "48": "icon.png",
        "128": "icon.png"
    }
}